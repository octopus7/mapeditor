# This version-controlled file must never contain real secret values.
# scripts/Initialize-Secrets.ps1 copies it to the Git-ignored .dev.vars file.

# GOOGLE_CLIENT_ID
# Purpose: Identifies the Google Web OAuth client used by the Pages popup and
#          by the Worker when validating the ID token audience.
# How to obtain: In Google Cloud Console, create an OAuth client with the
# application type "Web application" and copy its Client ID.
# This identifier is public and is not a client secret.
# Leave Authorized redirect URIs empty for the Google Identity Services popup flow.
GOOGLE_CLIENT_ID=

# MAPEDITOR_API_BASE_URL
# Purpose: Public Worker API origin injected into the Pages app-config.json at deploy time.
# How to obtain: Use the HTTPS origin printed after deploying the mapeditor-api Worker.
# This value is public configuration, not a secret, but keeping it in .dev.vars avoids
# repeating the -ApiBaseUrl argument on every Pages deployment.
MAPEDITOR_API_BASE_URL=

# SESSION_SECRET
# Purpose: Signs or encrypts the application's own login session.
# How to obtain: Generate a new cryptographically secure random value locally.
# PowerShell example:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Use a dedicated value and do not reuse a Cloudflare or Google credential.
SESSION_SECRET=

# BOOTSTRAP_TOKEN
# Purpose: Authenticates the initial administrator or bootstrap request.
# How to obtain: Generate a new cryptographically secure random token locally.
# PowerShell example:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Paste only the generated value after the equals sign in .dev.vars.
# Do not reuse a password, Cloudflare API token, or token from another service.
BOOTSTRAP_TOKEN=

# MEME_UPLOAD_TOKEN
# Purpose: Origin mutation bearer token used by the mapeditor Worker to call
#          meme's POST /internal/v1/blobs endpoint. It must never be sent to the browser.
# How to obtain: Use the same mutation token configured for meme's ORIGIN_ADMIN_TOKEN
#                (or the equivalent origin mutation secret) in the Git-ignored .dev.vars file.
# Do not generate a separate unrelated token unless the meme origin is configured to accept it.
MEME_UPLOAD_TOKEN=
